pipeline {
    agent any

    tools {
        jdk 'jdk25'
        maven 'Maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/kavindideepashika26-max/Queue.git'
            }
        }

        stage('Build') {
            steps {
                dir('queue-api') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('queue-api') {
                    bat 'docker build -t queue-api .'
                }
            }
        }
    }
}